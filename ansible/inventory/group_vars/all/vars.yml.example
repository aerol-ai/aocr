# Rename this file to vars.yml and remove the .example suffix
# Configure your deployment-specific variables here.

aocr_namespace: "aerol-system"
aocr_helm_release_name: "aocr"
aocr_helm_chart_ref: "oci://ghcr.io/aerol-ai/charts/aocr"
aocr_helm_chart_version: "1.0.2-main.28"

aocr_image_repository: "ghcr.io/aerol-ai"
aocr_image_tag: "latest"

# Set your custom domain
aocr_global_domain: "YOUR_DOMAIN_HERE"

# S3 Configuration
aocr_registry_s3_region: "us-east-1"
aocr_registry_s3_bucket: "YOUR_S3_BUCKET_NAME_HERE"
# Leave empty for real AWS S3 (SDK derives the regional endpoint). Set only
# for S3-compatible backends like MinIO, e.g. "http://minio:9000".
# aocr_registry_s3_endpoint: ""

aocr_auth_validationServiceUrl: "https://app.aerol.ai/api/auth/info"

# Paths to the JWT keys on the Ansible control node
aocr_jwt_private_key_path: "{{ playbook_dir }}/../../secrets/jwt-private.pem"
aocr_jwt_public_certificate_path: "{{ playbook_dir }}/../../secrets/jwt-public.crt"

# Path to the kubeconfig on the remote VM (used by helm).
# Default works for k3s. Override if you use a different distribution:
#   microk8s: /var/snap/microk8s/current/credentials/client.config
#   kubeadm:  /etc/kubernetes/admin.conf
aocr_remote_kubeconfig: "/etc/rancher/k3s/k3s.yaml"

# --- Phase 4: Authenticated Mirror + Auto-Import (F17-F21) -------------------
# Enable the mirror reverse-proxy deployment. When false (default), the
# wrap-auth + auto-import features are templated but the mirror vhost itself
# is not deployed — safe baseline. Flip to true to roll out the full stack.
aocr_mirror_enabled: false

# Mirror vhost. Defaults to mirror.<aocr_global_domain> when unset. Override
# only if you want a custom hostname (must have a matching DNS record).
# aocr_mirror_host: "mirror.example.com"

# Upstream registries the mirror will accept and pull-through-cache from.
# Comma-separated list of hostnames. Anything not on this list 404s at the
# mirror — keeps the cache surface scoped.
aocr_mirror_allow_list: "ghcr.io,gcr.io,quay.io,registry.k8s.io,docker.io"
