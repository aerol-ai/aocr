# Rename this file to secrets.yml and remove .example suffix
# Add your sensitive values here. DO NOT COMMIT secrets.yml to Git.
# You can also use ansible-vault to encrypt this file.

aocr_postgres_password: "YOUR_POSTGRES_PASSWORD"
aocr_redis_password: "YOUR_REDIS_PASSWORD"
aocr_hooks_token: "YOUR_HOOKS_TOKEN"
aocr_registry_replregSecret: "YOUR_REPLREG_SECRET"

# Admin Personal Access Token(s) for direct registry login.
# - End users authenticate via aocr_auth_validationServiceUrl (the API path).
# - Admins/CI authenticate by presenting one of these as the docker login password.
# - Leave unset to let the playbook auto-generate a 64-char token in secrets/auth_pat_token.
# - Supply a single value, OR a comma- or newline-separated list to allow multiple PATs:
#     aocr_auth_pat_token: "tok-one,tok-two,tok-three"
aocr_auth_pat_token: "YOUR_AUTH_PAT_TOKEN"

# AWS Profile to use for S3 credentials
# This profile must exist in your ~/.aws/credentials
aocr_aws_profile: "default"
