POSTGRES_DB=aocr
POSTGRES_USER=aocr_user
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me
HOOK_TOKEN=change-me

VALIDATION_SERVICE_URL=https://api.thirdparty.com/api/auth/info
JWT_PRIVATE_KEY=replace-me

# Optional static PAT validation fast-path for the auth service.
# If AUTH_PAT_TOKEN is set and the presented token matches it,
# the auth service validates locally, skips the upstream API call,
# skips auth-time DB sync, and ignores the presented Docker username.
# AUTH_PAT_TOKENS can be used for multiple PATs as a comma-separated list.
# If both PAT config and VALIDATION_SERVICE_URL are configured,
# PAT is checked first and the API is used as a fallback for non-matching tokens.
AUTH_PAT_TOKEN=
AUTH_PAT_TOKENS=

# Master metrics switch. When false, auth/hooks do not expose /metrics,
# registry Prometheus metrics are disabled, and Helm scrape resources stay inactive.
METRICS_ENABLED=false

REPLREG_HOST=aerol.ai
REPLREG_SECRET=change-me

S3_REGION=us-east-1
S3_BUCKET=aocr
S3_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

LOG_LEVEL=info
NODE_ENV=production
REAPER_SCHEDULE=* * * * *
# Optional: comma-separated repository UUIDs to limit the cron reaper scope.
# Leave empty to sweep all repositories.
REPOSITORY_IDS=

# Standard WASM module namespace. AerolVM stages curated language runtimes here
# and pins their digest into every sandbox; the auth service makes this prefix
# pull-only for tenant cluster PATs (writable only by the static/system PAT),
# and the reaper never reaps it. Default: wasm/std.
AOCR_WASM_STD_NAMESPACE=wasm/std
# Optional: comma/newline-separated repo-path prefixes the reaper must never
# touch (e.g. "wasm/std,acme/golden"). Defaults to AOCR_WASM_STD_NAMESPACE when
# unset, so standard modules are protected out of the box.
AOCR_RETENTION_PROTECTED_NAMESPACES=

# Garbage Collection
# To run local GC, use `docker-compose -f docker-compose.yaml -f docker-compose.gc.yaml up registry-gc`
# Set DRY_RUN=false to actually delete blobs.
DRY_RUN=true
