{
  "name": "aocr-auth",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev src/server.ts",
    "test": "tsc -p tsconfig.test.json && node --test 'dist-test/__tests__/**/*.test.js'",
    "test:coverage": "tsc -p tsconfig.test.json && METRICS_ENABLED=true c8 --check-coverage --lines 90 --include 'dist-test/**/*.js' --exclude 'dist-test/__tests__/**' node --test 'dist-test/__tests__/**/*.test.js'"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.37",
    "@types/pg": "^8.20.0",
    "c8": "^10.1.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
